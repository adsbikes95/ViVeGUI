<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Feature catalog: descriptive metadata about feature IDs (names, categories, sources,
    build compatibility). Deliberately separate from feature *state* (ViVe.Core).
    Catalogs are data only (JSON / the upstream name dictionary); nothing is executed.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned list of mach2 feature dumps with SHA-256 hashes; imports are checked against it. -->
    <EmbeddedResource Include="..\..\catalog\mach2-manifest.txt" LogicalName="ViVe.FeatureCatalog.mach2-manifest.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ViVe.Studio.Tests" />
  </ItemGroup>
</Project>
