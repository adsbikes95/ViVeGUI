<UserControl x:Class="ViVe.Studio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBarTemplate}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Label Content="_Theme" Target="{Binding ElementName=ThemeBox}" Width="160" />
                        <ComboBox x:Name="ThemeBox" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Width="200" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="System follows the Windows light/dark setting. Mica and rounded corners are used on Windows 11 where supported." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Safety" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Show _experimental-feature warnings on the dashboard" IsChecked="{Binding ShowExperimentalWarnings}" Margin="0,0,0,8" />
                    <DockPanel>
                        <Label Content="Default _stores" Target="{Binding ElementName=StoresBox}" Width="160" />
                        <ComboBox x:Name="StoresBox" ItemsSource="{Binding StoreOptions}" SelectedItem="{Binding DefaultStores}" Width="300" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Every change is previewed and must be confirmed. Higher-risk changes (non-default priorities, experiment flag, multi-priority resets) show an additional warning." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Logging and data" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Write a diagnostic _log file" IsChecked="{Binding EnableFileLogging}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="History, settings and logs are stored in: " /><Run Text="{Binding DataDirectory, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Feature catalog" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding CatalogSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CatalogUpdateText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="_Remove" Command="{Binding ClearCatalogCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="_Browse..." Command="{Binding BrowseCatalogCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding UserCatalogPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Local catalog file" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding CatalogMessages}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Scan this build for feature names" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ScanAboutText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ScanStatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Scan _this build..." Command="{Binding ScanBuildCommand}" Margin="0,0,8,0" MinWidth="96" />
                        <Button Content="Ca_ncel scan" Command="{Binding CancelScanCommand}" Margin="0,0,8,0" MinWidth="96" />
                        <Button Content="Remove scan results" Command="{Binding RemoveScansCommand}" Margin="0,0,8,0" MinWidth="96" />
                    </WrapPanel>
                    <TextBox Text="{Binding ScanProgressText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Scan progress and results" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Feature names from mach2" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Mach2AboutText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Mach2StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="_Download and import..." Command="{Binding ImportMach2Command}" Margin="0,0,8,0" MinWidth="96" />
                        <Button Content="Import from a _local mach2 clone..." Command="{Binding ImportMach2FolderCommand}" Margin="0,0,8,0" MinWidth="96" />
                        <Button Content="Remove i_mport" Command="{Binding RemoveMach2Command}" Margin="0,0,8,0" MinWidth="96" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Mach2ProgressText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="Cross-check with this PC" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Compares the feature IDs configured in this PC's runtime feature store (what ViVeTool /query lists) with the catalog. Read-only." />
                    <Button Content="_Cross-check" Command="{Binding CrossCheckCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="96" />
                    <TextBlock Text="{Binding CrossCheckText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBox Text="{Binding CrossCheckUnnamedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Feature IDs without a name" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Configuration" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Content="E_xport settings..." Command="{Binding ExportSettingsCommand}" Margin="0,0,8,0" MinWidth="96" />
                        <Button Content="_Import settings..." Command="{Binding ImportSettingsCommand}" Margin="0,0,8,0" MinWidth="96" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding AboutText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
