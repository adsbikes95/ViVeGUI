<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ViVeTool Studio WPF application. Uses the Fluent theme that ships with WPF in .NET 9+
    (Application.ThemeMode: light/dark/system, Mica backdrop on Windows 11) to avoid a
    third-party UI dependency. Runs as the invoking user; changes require restarting elevated.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ViVe.Studio</RootNamespace>
    <AssemblyName>ViVeToolStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- WPF0001: Fluent ThemeMode API is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ViVe.Core\ViVe.Core.csproj" />
    <ProjectReference Include="..\ViVe.FeatureCatalog\ViVe.FeatureCatalog.csproj" />
    <ProjectReference Include="..\ViVe.Studio.Core\ViVe.Studio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\Extra\FeatureDictionary.pfs" Link="FeatureDictionary.pfs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\catalog\feature-catalog.json" Link="feature-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
