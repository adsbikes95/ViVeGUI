<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Upstream ViVe library (GPL-3.0, @thebookisclosed), converted to an SDK-style project.
    Source files are unchanged; the library is multi-targeted so that the original
    .NET Framework 4.8.1 ViVeTool build and the new .NET 10 projects share it.
  -->
  <PropertyGroup>
    <TargetFrameworks>net481;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Albacore.ViVe</RootNamespace>
    <AssemblyName>Albacore.ViVe</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <!-- Keep the upstream Properties/AssemblyInfo.cs as the single source of version info. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- The library only works on Windows (ntdll.dll / HKLM). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
