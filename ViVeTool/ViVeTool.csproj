<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Upstream ViVeTool CLI (GPL-3.0, @thebookisclosed), converted to an SDK-style project.
    net481 is the backwards-compatible build that runs on stock Windows without extra runtimes
    (this is what upstream ships). net10.0 is built so that the CLI can be regression-tested
    on any OS and so that a modern build is available.
  -->
  <PropertyGroup>
    <TargetFrameworks>net481;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Albacore.ViVeTool</RootNamespace>
    <AssemblyName>ViVeTool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Platforms kept from the upstream solution (AnyCPU and ARM64). -->
    <Platforms>AnyCPU;ARM64</Platforms>
    <!-- CA1416: Windows-only APIs. SYSLIB0014/0021: WebClient / SHA1CryptoServiceProvider in upstream UpdateCheck.cs. -->
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014;SYSLIB0021</NoWarn>
  </PropertyGroup>

  <!-- Upstream Debug builds enable the hidden /setlkg command. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);SET_LKG_COMMAND</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViVe\ViVe.csproj" />
    <ProjectReference Include="..\src\ViVe.Core\ViVe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- packages.config is superseded by PackageReference. -->
    <None Remove="packages.config" />
    <None Include="..\Extra\FeatureDictionary.pfs" Link="FeatureDictionary.pfs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
